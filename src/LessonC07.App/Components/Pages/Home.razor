@page "/"
@rendermode InteractiveServer
@implements IDisposable
@using LessonC07.App.Lab
@inject LabSettings Settings
@inject SessionRunner Runner

<PageTitle>Session Lifecycle · Lesson C07</PageTitle>
<HeadContent>
    <link rel="stylesheet" href="style.css" />
    <style>
        label{display:block;font-size:17px;font-weight:700;margin:15px 0 8px}textarea{width:100%;font:inherit;color:#090d3b;padding:12px;border:1px solid #cbdff2;border-radius:9px;background:white;resize:vertical}button{margin-top:18px}.events{max-height:250px;overflow:auto;list-style:none;padding:0}.events li{padding:9px;border-bottom:1px solid #e1e7f3;font-size:16px}.guide{background:#e9fbf2;border-radius:16px;padding:20px;color:#193269;font-size:17px;line-height:1.6}.answer{background:#e9fbf2;border-radius:12px;padding:14px;color:#095a3b;white-space:pre-wrap}.card p{font-size:17px}
        body{font-size:20px} .card p,.status,.data code,.events li,.flow small,.orb small,.badge{font-size:18px} .card label{font-size:20px} .student-nav{clear:both} main{min-width:0} pre{max-width:100%;overflow:auto}
    </style>
</HeadContent>

<header><div class="wrap top"><div class="brand">How <span>Claude Managed Agents</span> Works</div><span class="badge">CONCEPT 07 / 60</span></div></header>
<main class="wrap">
    <section id="application-lab" aria-label="Application navigation"><StudentNav /></section>
    <div class="intro">
        <div>
            <p class="eyebrow">CLAUDE MANAGED AGENTS / LESSON 07</p>
            <h1>Read the stop reason.<br><em>Know what happens next.</em></h1>
            <p class="lead">Follow a real session and distinguish a completed turn from a pause, an error, or an incomplete observation.</p>
        </div>
        <div class="orb"><img src="astronaut.png" alt=""><small>LESSON C07<br>SESSION LIFECYCLE</small></div>
    </div>
    <section class="flow">
        <div><b>01</b><span><strong>Start</strong><small>Create a session</small></span></div><i>→</i>
        <div><b>02</b><span><strong>Observe</strong><small>Read live events</small></span></div><i>→</i>
        <div><b>03</b><span><strong>Classify</strong><small>Inspect stop reason</small></span></div>
    </section>
    <section class="grid">
        <article class="card">
            <p class="eyebrow">THE EXPERIMENT</p>
            <h2>Observe a turn</h2>
            <p>Each run creates a remote session with a list-cost budget. The host does not automatically approve requests or increase budgets.</p>
            <label for="prompt">Your prompt</label>
            <textarea id="prompt" rows="3" maxlength="@MaxPrompt" @bind="prompt"></textarea>
            <button id="run" disabled="@(!Settings.Configured || running)" @onclick="RunAsync">Start and observe <span>↗</span></button>
            <p id="status" class="status" role="status">@status</p>
            @if (!string.IsNullOrEmpty(answer))
            {
                <div id="answer" class="answer">@answer</div>
            }
        </article>
        <article class="card results">
            <div class="resulthead"><div><p class="eyebrow">LIFECYCLE EVIDENCE</p><h2>Read the outcome</h2></div><span class="live">● LIVE API</span></div>
            @if (!started)
            {
                <p id="empty">The session, events, stop reason and outcome will appear here.</p>
            }
            else
            {
                <div id="result">
                    <div class="data"><span>SESSION ID</span><code id="session">@sessionId</code></div>
                    <div class="data"><span>STOP REASON</span><code id="reason">@reason</code></div>
                    <div class="data"><span>OUTCOME</span><code id="outcome">@outcome</code></div>
                    <ul id="events" class="events">
                        @foreach (var e in events)
                        {
                            <li>@e</li>
                        }
                    </ul>
                </div>
            }
        </article>
    </section>
    <div class="guide"><strong>Read state and reason together.</strong> End turn marks a finished turn; requires action needs a host response; budget reached is a pause; termination needs investigation. This sample reports a pending action rather than answering it. Closing the page does not stop remote work.</div>
    <footer>LESSON C07 <span>·</span> START → OBSERVE → CLASSIFY</footer>
</main>

@code {
    private const int MaxPrompt = 2000;
    private readonly CancellationTokenSource disposed = new();
    private readonly List<string> events = [];
    private string prompt = "Explain why a stop reason matters in one sentence.";
    private string status = "";
    private string sessionId = "—", reason = "Waiting", outcome = "Waiting for evidence", answer = "";
    private bool running, started, finished, failed;

    protected override void OnInitialized() =>
        status = Settings.Configured
            ? "Configuration ready. Credentials stay on the server."
            : "Configure the API key, agent ID and environment ID in .env.";

    private async Task RunAsync()
    {
        var text = prompt.Trim();
        if (text.Length == 0) { status = "Enter a prompt."; return; }
        if (text.Length > MaxPrompt) { status = $"Enter a prompt of up to {MaxPrompt:N0} characters."; return; }

        running = started = true;
        finished = failed = false;
        status = "Creating session…";
        sessionId = "—"; reason = "Waiting"; outcome = "Waiting for evidence"; answer = "";
        events.Clear();

        try
        {
            await Runner.RunAsync(text, update => InvokeAsync(() => { Apply(update); StateHasChanged(); }), disposed.Token);
            if (!finished && !failed && !disposed.IsCancellationRequested)
            {
                outcome = "Incomplete";
                status = "Stream ended without a terminal outcome.";
            }
        }
        finally
        {
            running = false;
        }
    }

    private void Apply(LabUpdate update)
    {
        switch (update.Type)
        {
            case "session": sessionId = update.Value; status = "Observing live events…"; break;
            case "event": events.Add(update.Value); break;
            case "answer": answer += update.Value; break;
            case "reason": reason = update.Value; break;
            case "outcome": finished = true; outcome = update.Value; status = "Observation finished."; break;
            case "error": failed = true; outcome = "Error; completion not confirmed"; status = update.Value; break;
        }
    }

    // Leaving the page stops observing; it does not cancel the remote session.
    public void Dispose()
    {
        disposed.Cancel();
        disposed.Dispose();
    }
}
